user www-data;
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile            on;
    tcp_nopush          on;
    tcp_nodelay         on;
    keepalive_timeout   65;
    types_hash_max_size 2048;

    include             /etc/nginx/mime.types;
    default_type        application/octet-stream;

    # Upstream servers
    upstream web_backend {
        server {{ webserver_private_ip }}:80;
    }

    upstream phpmyadmin_backend {
        server {{ dbserver_private_ip }}:80;
    }

    # Main server block
    server {
        listen       80 default_server;
        listen       [::]:80 default_server;
        server_name  _;
        # Redirections relatives : correctes quelle que soit l'adresse publique du bastion
        absolute_redirect off;

        # Root location - serve web server
        location / {
            proxy_pass http://web_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        # phpMyAdmin : une seule adresse, /pma/ (l'ancienne /phpmyadmin/ y redirige)
        location = /phpmyadmin { return 301 /pma/; }
        location /phpmyadmin/ { return 301 /pma/; }

        location /pma/ {
            # 1re barrière : authentification HTTP sur le bastion (identifiants dans le vault)
            auth_basic           "Administration";
            auth_basic_user_file /etc/nginx/.htpasswd_pma;

            proxy_pass http://phpmyadmin_backend/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # Le mot de passe du bastion n'a pas à être transmis à phpMyAdmin
            proxy_set_header Authorization "";

            # phpMyAdmin croit être servi à la racine : on garde ses redirections et cookies sous /pma/
            proxy_redirect ~^https?://[^/]+/(.*)$ /pma/$1;
            proxy_redirect / /pma/;
            proxy_cookie_path / /pma/;
        }
    }
}
